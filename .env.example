# Everything below is OPTIONAL. Jellyfin servers and NAS shares are normally
# configured from the web UI (Settings tab) and saved in /data/config.json.
# These values only pre-seed a fresh install.
# JELLYFIN_URL=http://192.168.1.10:8096
# JELLYFIN_API_KEY=
# MEDIA_PATHS=/media
# SYNC_INTERVAL_MINUTES=60
