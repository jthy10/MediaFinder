# Jellyfin (optional) - create a key in Dashboard > API Keys
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=

# Folder scan (optional) - comma separated paths *inside the container*.
# Each subfolder (Movies, TV, ...) becomes a library.
MEDIA_PATHS=/media

# 0 = manual sync only. Otherwise re-sync every N minutes.
SYNC_INTERVAL_MINUTES=60
